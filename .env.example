# The Quiet Minute — environment variables
#
# Copy this file to ".env.local" and fill in the values, then restart the dev
# server (npm run dev). Vite only exposes variables prefixed with VITE_ to the
# browser. The anon key is public by design and safe to ship in the frontend.
#
# Find both values in your Supabase dashboard:
#   Project Settings → API → "Project URL" and "Project API keys → anon public".

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Switch the paid layer from the pre-launch waitlist popup to the live members
# area. Leave as "false" until payments are wired up.
VITE_DAILY_PRACTICE_LAUNCHED=false

# Server-side only — set these in Vercel → Environment Variables, NOT here and
# NOT prefixed with VITE_ (they must never reach the browser):
#   MAILERLITE_API_KEY    — MailerLite → Integrations → API (powers /api/waitlist)
#   MAILERLITE_GROUP_ID   — the "TQM Daily Practice Waitlist" group id
